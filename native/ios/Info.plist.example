<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Aero</string>
  <key>CFBundleName</key>
  <string>Aero</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>NSCameraUsageDescription</key>
  <string>Aero uses the camera only when you photograph homework or written work. Photos stay on this device and are never uploaded.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Aero uses the microphone only when you tap Talk so the on-device voice tutor can hear you. Audio is not recorded or sent to our servers.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Aero uses on-device speech recognition so you can speak answers and questions. Speech is not stored or sent to Aero.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Aero lets you choose a photo of homework so the coach can name the concept. Images stay on this device.</string>
  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>
  <key>UIRequiresFullScreen</key>
  <true/>
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>
</dict>
</plist>
